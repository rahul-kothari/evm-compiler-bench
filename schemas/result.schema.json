{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVM Compiler Bench result row",
  "type": "object",
  "required": [
    "benchmark_id",
    "implementation_id",
    "language",
    "compiler",
    "source_hash",
    "compile",
    "bytecode",
    "gas",
    "correctness"
  ],
  "properties": {
    "benchmark_id": { "type": "string" },
    "implementation_id": { "type": "string" },
    "language": { "enum": ["solidity", "vyper"] },
    "compiler": { "type": "object" },
    "source_hash": { "type": "string" },
    "compile": { "type": "object" },
    "bytecode": { "type": "object" },
    "gas": { "type": "object" },
    "correctness": { "type": "object" }
  }
}
